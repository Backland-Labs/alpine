# alpine.yaml - Configuration for Alpine dev environments
#
# Place this file in your project root and rename to alpine.yaml.
# All fields are optional. Defaults are shown in comments.

# Base Docker image for the dev container.
# Default: ubuntu:24.04
# base_image: ubuntu:24.04

# Command to run after cloning the repo.
# Runs as: sh -c "cd /workspace && <install>"
# Default: (none)
# install: npm install

# Files to copy from the host into /workspace/ in the container.
# Missing files are skipped with a warning.
# Paths are relative to the git root and cannot escape it.
# Default: (none)
# env_files:
#   - .env

# Services to start alongside the dev container.
# Supported: postgres, redis
# Default: (none)
# services:
#   - postgres
#   - redis
