# alpine.yaml - Cloud orchestrator defaults

repo:
  # Default repository used when --repo is omitted.
  # Required unless passed per launch.
  default: https://github.com/your-org/your-repo.git

sandbox:
  # Default image profile key.
  image_profile: default

  # Profile -> Cloudflare container class mapping.
  image_profiles:
    default: opencode-default
    heavy: opencode-heavy

  # Control plane URL for Worker API.
  control_plane_url: http://127.0.0.1:8787

  # Base URL used by `alpine open`.
  web_base_url: https://<worker>.workers.dev

  # Auto-teardown policy after successful durable save.
  auto_teardown: true

  # Retention window for completed state before destroy.
  completed_retention_minutes: 60

durability:
  # Durable checkpoint backing store metadata.
  bucket: alpine-checkpoints
  checkpoint_prefix: sandboxes

github:
  # Export branch prefix.
  branch_prefix: alpine

  # Require GH_TOKEN/GITHUB_TOKEN for export.
  require_auth: true

# Legacy local-Docker fields are still recognized by hidden `alpine create`:
# base_image: ubuntu:24.04
# install: npm install
# env_files:
#   - .env
# services:
#   - postgres
