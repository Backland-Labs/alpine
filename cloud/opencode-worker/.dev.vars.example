# Example development variables for local wrangler dev
# Copy this file to .dev.vars and fill in your values
# NEVER commit .dev.vars to the repository

# Environment identifier
ENVIRONMENT=development

# OpenCode OpenAI auth payload (base64 encoded JSON)
# Generated by: scripts/sync-opencode-auth.sh --local
# Contains only OpenAI credentials extracted from ~/.local/share/opencode/auth.json
OPENCODE_AUTH_OPENAI_B64=

# Optional: Control plane URL for remote sandbox orchestration
# CONTROL_PLANE_URL=http://127.0.0.1:8787
